{
  "name": "yukkuri-exosome",
  "version": "0.1.0",
  "private": true,
  "description": "Kimito-Linkのゆっくりエクソソーム — Web + iOS (Capacitor) + Android (Bubblewrap TWA)",
  "homepage": "https://yukkuri-exosome.link/",
  "scripts": {
    "web:dev": "http-server src -p 8765 -c-1",
    "web:serve": "http-server src -p 8765 -c-1",
    "cap:copy": "node scripts/copy-web-to-www.mjs",
    "cap:sync": "npm run cap:copy && cap sync",
    "ios:add": "cap add ios",
    "ios:open": "cap open ios",
    "ios:sync": "npm run cap:copy && cap sync ios",
    "android:twa:init": "bubblewrap init --manifest=https://yukkuri-exosome.link/manifest.webmanifest --directory=./android-twa && node scripts/android-patch-signing.mjs",
    "android:twa:update": "bubblewrap update --directory=./android-twa && node scripts/android-patch-signing.mjs",
    "android:twa:build": "bubblewrap build --directory=./android-twa",
    "android:twa:patch-signing": "node scripts/android-patch-signing.mjs",
    "assets:store": "node scripts/generate-store-assets.mjs",
    "assets:store:A": "node scripts/generate-store-assets.mjs --only A",
    "assets:store:B": "node scripts/generate-store-assets.mjs --only B",
    "assets:store:C": "node scripts/generate-store-assets.mjs --only C",
    "release:bump": "node scripts/release-bump.mjs",
    "release:bump:patch": "node scripts/release-bump.mjs --patch",
    "release:bump:minor": "node scripts/release-bump.mjs --minor",
    "release:play": "node scripts/play-publish.mjs",
    "release:play:draft": "node scripts/play-publish.mjs --draft",
    "release:play:status": "node scripts/play-publish.mjs --status",
    "release:play:check": "node scripts/play-review-check.mjs",
    "release:play:diagnose": "node scripts/play-diagnose.mjs",
    "release:appstore:submit": "node scripts/appstore-submit.mjs",
    "release:appstore:release-pending": "node scripts/appstore-release-pending.mjs",
    "release:appstore:release-now": "node scripts/appstore-release-now.mjs",
    "release:appstore:check": "node scripts/asc-review-check.mjs",
    "play:set-listing": "node scripts/play-set-listing.mjs",
    "play:set-app-content": "node scripts/play-set-app-content.mjs",
    "setup": "node scripts/setup-new-app.mjs",
    "generate:privacy": "node scripts/generate-privacy-page.mjs"
  },
  "devDependencies": {
    "@bubblewrap/cli": "^1.24.1",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/splash-screen": "^8.0.0",
    "http-server": "^14.1.1",
    "typescript": "^6.0.3"
  }
}

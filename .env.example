# Release automation secrets — ローカルで `Get-Content .env | ForEach-Object { ... }` 等で読み込んで使う。
# このファイルをコピーして .env を作る (.gitignore で除外済み)。

# --- App Store Connect API ---
APPSTORE_CONNECT_KEY_ID=
APPSTORE_CONNECT_ISSUER_ID=
APPSTORE_CONNECT_API_KEY_P8_PATH=C:\Users\info\OneDrive\Apple\AuthKey_P8W74LR2GH.p8
# もしくは base64 でも可:
# APPSTORE_CONNECT_API_KEY_P8_BASE64=

# Apple Developer
APPLE_TEAM_ID=
APP_BUNDLE_ID=com.kimito.link.yukkuriexosome

# --- Google Play ---
GOOGLE_PLAY_SA_JSON_PATH=
# ↑ fujisan用JSONは com.kimito.fujisancompass にしか権限がないので、
#   Play Console > ユーザーと権限 で yukkuriexosome アプリにも招待する必要あり。
#   または新規SAを発行して PLAY_PACKAGE_NAME=com.kimito.link.yukkuriexosome に紐付ける。
PLAY_PACKAGE_NAME=com.kimito.link.yukkuriexosome
PLAY_TRACK=internal
PLAY_AAB_PATH=android-twa/app/build/outputs/bundle/release/app-release.aab

# --- App Store Connect submission options ---
RELEASE_VERSION=0.1.0
UPDATE_WHATS_NEW=1

# --- Android signing (already in android-twa/keystore.properties) ---
# BUBBLEWRAP_KEYSTORE_PASSWORD=
# BUBBLEWRAP_KEY_PASSWORD=
